# ==========================================
# KaniMart - Git Ignore
# ==========================================

# ------------------------------
# Secrets / local configuration
# ------------------------------
.env
.env.*
!.env.example

config.json
*.secret
*.secrets

# ------------------------------
# Build directories
# ------------------------------
build/
build-*/
cmake-build-*/
out/
bin/
obj/

# CMake generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
compile_commands.json
CTestTestfile.cmake
_deps/

# ------------------------------
# vcpkg
# ------------------------------
vcpkg_installed/

# ------------------------------
# Visual Studio / VS Code
# ------------------------------
.vs/
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates

# ------------------------------
# Compiled files
# ------------------------------
*.exe
*.dll
*.so
*.dylib
*.a
*.lib
*.obj
*.o
*.pdb
*.ilk

# ------------------------------
# Logs
# ------------------------------
*.log
logs/

startup.log

# ------------------------------
# Temporary files
# ------------------------------
*.tmp
*.temp
*.swp
*.swo
*~
temp_*.cpp
temp_*.h

# ------------------------------
# Runtime uploads
# ------------------------------
uploads/tmp/
uploads/*
!uploads/.gitkeep

# ------------------------------
# OS files
# ------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ------------------------------
# Node / frontend tooling
# ------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ------------------------------
# Test / coverage output
# ------------------------------
coverage/
*.gcda
*.gcno
*.gcov

# ------------------------------
# Archives
# ------------------------------
*.zip
*.tar
*.tar.gz

# ------------------------------
# IDE / editor backups
# ------------------------------
*.bak
*.orig
*.rej